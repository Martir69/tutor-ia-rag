# ── Ollama ────────────────────────────────────────────────────────────────────
# URL del servidor Ollama. En Docker usa el nombre del servicio.
# En local: http://localhost:11434
OLLAMA_HOST=http://ollama:11434

# Modelo LLM a usar (debe estar descargado en Ollama)
LLM_MODEL=phi3:mini

# ── Gradio ────────────────────────────────────────────────────────────────────
# En Docker: 0.0.0.0 para ser accesible desde el host
# En local: 127.0.0.1
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
